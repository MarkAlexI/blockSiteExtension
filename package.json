{
  "name": "blockdistraction-extension",
  "version": "5.2.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=**/tests/** --test-coverage-exclude=**/tools/**",
    "validate": "node tools/validate-extension.js",
    "check": "npm run test && npm run validate",
    "package:store": "node tools/package-store.js chrome",
    "package:cws": "node tools/package-store.js chrome",
    "package:edge": "node tools/package-store.js edge",
    "package:stores": "node tools/package-store.js all"
  }
}
